# Copy to .env and fill in only what you need. Sensitiv runs with an EMPTY .env:
# the fake LLM provider and fixture-backed adapters keep the whole loop green.
# Keys below only unlock live runs.

# Anthropic — required for real planning; leave empty to run with the fake provider
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic

# Solari browser automation — leave empty to run adapters against fixtures
SOLARI_API_KEY=
# Fallback proxy country (ISO 3166-1 alpha-2) when the job location has none
SOLARI_PROXY_COUNTRY=ca

# SQLite (libsql). Relative to repo root.
DATABASE_URL=file:./data/sensitiv.db

# Worker
WORKER_URL=http://127.0.0.1:8787
WORKER_PORT=8787
DEFAULT_JOB_TIMEOUT_SEC=480

# How long downloaded session replays are kept in data/replays/, in days.
# 0 (the default) keeps them FOREVER — nothing is ever deleted. Set a positive
# number to bound it; the worker sweeps once at startup.
# Recordings are only captured when a run opts in ("Record this run's browser
# session" under Advanced settings), and they are 1-20 MB each.
REPLAY_RETENTION_DAYS=0
