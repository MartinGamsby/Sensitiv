{
  "name": "sensitiv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sensitiv/web --filter @sensitiv/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --parallel test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @sensitiv/db migrate",
    "db:seed": "pnpm --filter @sensitiv/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.1"
  }
}
